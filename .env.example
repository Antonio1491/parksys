# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS (REQUERIDO)
# ===========================================
# Para desarrollo local:
DATABASE_URL=postgresql://usuario:password@localhost:5432/parksys

# Para Railway (se configura automáticamente si agregas PostgreSQL):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
PORT=5000
NODE_ENV=development
# Para producción en Railway usar: NODE_ENV=production

# ===========================================
# CONFIGURACIÓN DE EMAIL (Opcional - para envío de correos)
# ===========================================
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password

# ===========================================
# URL BASE DE LA APLICACIÓN
# ===========================================
# Para desarrollo:
BASE_URL=http://localhost:5000
# Para Railway (usar tu dominio asignado):
# BASE_URL=https://tu-app.up.railway.app

# ===========================================
# SERVICIOS EXTERNOS (Opcionales)
# ===========================================

# Stripe (pagos)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (email alternativo)
# SENDGRID_API_KEY=SG...

# Google Cloud Storage (almacenamiento de archivos)
# Opción 1: Credenciales como JSON string (recomendado para Railway)
# GCS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}
# Opción 2: Archivo de credenciales (para desarrollo local)
# GCS_KEY_FILE=path/to/service-account.json
GCS_PROJECT_ID=parksys-c3d30
GCS_BUCKET_NAME=parksys_central

# Firebase
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# FIREBASE_PRIVATE_KEY=...
# FIREBASE_CLIENT_EMAIL=...

# Google Maps API
# GOOGLE_MAPS_API_KEY=AIza...

# ===========================================
# RAILWAY - Variables automáticas
# ===========================================
# Railway configura automáticamente:
# - PORT (el puerto asignado)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_PUBLIC_DOMAIN (tu dominio .up.railway.app)
