# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS (REQUERIDO)
# ===========================================
DATABASE_URL=postgresql://root:root@localhost:5432/parksys

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# CONFIGURACIÓN DE EMAIL (Opcional - para envío de correos)
# ===========================================
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password

# ===========================================
# URL BASE DE LA APLICACIÓN
# ===========================================
BASE_URL=http://localhost:5000

# ===========================================
# SERVICIOS EXTERNOS (Opcionales)
# ===========================================

# Stripe (pagos)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# SendGrid (email alternativo)
# SENDGRID_API_KEY=SG...

# Google Cloud Storage (almacenamiento de archivos)
# GCS_PROJECT_ID=tu-proyecto
# GCS_BUCKET_NAME=tu-bucket
# GCS_KEY_FILE=path/to/service-account.json

# Firebase
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# FIREBASE_PRIVATE_KEY=...
# FIREBASE_CLIENT_EMAIL=...

# Google Maps API
# GOOGLE_MAPS_API_KEY=AIza...
